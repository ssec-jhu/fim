{
  "version": "1",
  "steps": {
    "distortion": {
      "title": "Distortion",
      "script": "legacy/run_distortion.py",
      "essential": [
        {
          "key": "with_sphere",
          "label": "Deformed image (with sphere)",
          "description": "3D TIFF with the calibration sphere",
          "type": "file",
          "accept": ".tif,.tiff"
        },
        {
          "key": "without_sphere",
          "label": "Reference image (without sphere)",
          "description": "3D TIFF of the undeformed sample",
          "type": "file",
          "accept": ".tif,.tiff"
        },
        {
          "key": "dxy_um",
          "label": "Voxel size XY",
          "description": "Pixel spacing in X and Y",
          "type": "number",
          "default": 0.492,
          "step": 0.01,
          "unit": "\u00b5m",
          "sync": "dxy_um"
        },
        {
          "key": "dz_um",
          "label": "Voxel size Z",
          "description": "Spacing between Z slices",
          "type": "number",
          "default": 3.0,
          "step": 0.01,
          "unit": "\u00b5m",
          "sync": "dz_um"
        },
        {
          "key": "sphere_diameter_mm",
          "label": "Sphere diameter",
          "description": "Calibration sphere diameter (distortion correction)",
          "type": "number",
          "default": 0.5,
          "step": 0.1,
          "unit": "mm",
          "sync": "sphere_diameter_mm"
        }
      ],
      "advanced": [
        {
          "key": "n_medium",
          "label": "Material refractive index",
          "description": "Refractive index of gel/medium",
          "type": "number",
          "default": 1.4,
          "step": 0.01
        },
        {
          "key": "n_sphere",
          "label": "Sphere refractive index",
          "description": "Refractive index of the sphere",
          "type": "number",
          "default": 1.5,
          "step": 0.01
        }
      ]
    },
    "tracking": {
      "title": "Tracking",
      "script": "github/fim/fim/refactor/deformation_tracking.py",
      "common": {
        "essential": [
          {
            "key": "with_sphere",
            "label": "Deformed image (with sphere)",
            "description": "3D TIFF with indenter (deformed state)",
            "type": "file",
            "accept": ".tif,.tiff",
            "default": "DEFAULT_WITH_SPHERE"
          },
          {
            "key": "without_sphere",
            "label": "Reference image (without sphere)",
            "description": "3D TIFF, undeformed (no indenter)",
            "type": "file",
            "accept": ".tif,.tiff",
            "default": "DEFAULT_WITHOUT_SPHERE"
          },
          {
            "key": "out_dir",
            "label": "Output folder",
            "description": "Output folder for Ux/Uy/Uz and metadata",
            "type": "dir",
            "default": "./fim/legacy/output/deformation-tracking"
          },
          {
            "key": "dxy_um",
            "label": "Voxel size XY",
            "description": "XY pixel spacing (synced with Step 1)",
            "type": "number",
            "default": 0.492,
            "step": 0.01,
            "unit": "\u00b5m",
            "sync": "dxy_um"
          },
          {
            "key": "dz_um",
            "label": "Voxel size Z",
            "description": "Z slice spacing (synced with Step 1)",
            "type": "number",
            "default": 3.0,
            "step": 0.01,
            "unit": "\u00b5m",
            "sync": "dz_um"
          },
          {
            "key": "sphere_diameter_mm",
            "label": "Sphere diameter",
            "description": "Sphere/indenter diameter (synced with Step 1)",
            "type": "number",
            "default": 0.5,
            "step": 0.1,
            "unit": "mm",
            "sync": "sphere_diameter_mm"
          }
        ],
        "advanced": [
          {
            "key": "downsamp_xy",
            "label": "Image downsample (XY)",
            "description": "Input XY downsample factor before optimization",
            "type": "number",
            "default": 2,
            "step": 1,
            "min": 1
          },
          {
            "key": "downsamp_z",
            "label": "Image downsample (Z)",
            "description": "Input Z downsample factor before optimization",
            "type": "number",
            "default": 1,
            "step": 1,
            "min": 1
          },
          {
            "key": "z_start",
            "label": "Z crop start",
            "description": "First Z index (0-based); drops slices above",
            "type": "number",
            "default": 0,
            "step": 1,
            "min": 0
          },
          {
            "key": "z_end",
            "label": "Z crop end (exclusive)",
            "description": "End Z index (exclusive); empty = all slices",
            "type": "number",
            "default": null,
            "step": 1,
            "min": 1
          },
          {
            "key": "device",
            "label": "Device",
            "description": "Device (auto uses GPU if available)",
            "type": "select",
            "default": "auto",
            "options": [
              "auto",
              "cpu",
              "cuda"
            ]
          },
          {
            "key": "output_downsample_xy",
            "label": "Output downsample (XY)",
            "description": "Save XY downsample (1 = full resolution)",
            "type": "number",
            "default": 10,
            "step": 1,
            "min": 1
          },
          {
            "key": "output_downsample_z",
            "label": "Output downsample (Z)",
            "description": "Save Z downsample (1 = full resolution)",
            "type": "number",
            "default": 3,
            "step": 1,
            "min": 1
          },
          {
            "key": "upsample_order",
            "label": "Upsample interpolation order",
            "description": "Interpolator for coarse\u2192full upsampling",
            "type": "select",
            "default": 3,
            "options": [
              {
                "value": "1",
                "label": "1 \u2014 Linear"
              },
              {
                "value": "2",
                "label": "2 \u2014 Quadratic"
              },
              {
                "value": "3",
                "label": "3 \u2014 Cubic (legacy)"
              }
            ]
          },
          {
            "key": "smooth_method",
            "label": "Output smoothing",
            "description": "Smoothing on saved Ux/Uy/Uz",
            "type": "select",
            "default": "none",
            "options": [
              {
                "value": "none",
                "label": "None"
              },
              {
                "value": "gaussian",
                "label": "Gaussian (low-pass)"
              },
              {
                "value": "laplacian",
                "label": "Laplacian (diffusion)"
              }
            ]
          },
          {
            "key": "smooth_sigma",
            "label": "Smoothing strength",
            "description": "Gaussian \u03c3 or Laplacian strength (typ. 0.5\u20135)",
            "type": "number",
            "default": 1.0,
            "step": 0.5,
            "min": 0.5
          },
          {
            "key": "lr_shift",
            "label": "LR: global shift",
            "description": "LR for global rigid translation",
            "type": "number",
            "default": 0.05
          },
          {
            "key": "lr_axis",
            "label": "LR: rotation axis",
            "description": "LR for rotation axis",
            "type": "number",
            "default": 0.001
          },
          {
            "key": "lr_angle",
            "label": "LR: rotation angle",
            "description": "LR for rotation angle",
            "type": "number",
            "default": 1e-05
          },
          {
            "key": "lr_deform",
            "label": "LR: deformation",
            "description": "LR for local deformation",
            "type": "number",
            "default": 0.1
          },
          {
            "key": "skip_grids",
            "label": "skip_grids",
            "type": "boolean",
            "default": null
          },
          {
            "key": "save_comparison_figure",
            "label": "save_comparison_figure",
            "type": "boolean",
            "default": null
          },
          {
            "key": "remap_to_reference",
            "label": "remap_to_reference",
            "type": "boolean",
            "default": null
          },
          {
            "key": "remap_interp",
            "label": "remap_interp",
            "type": "select",
            "default": "linear",
            "options": [
              "linear",
              "nearest"
            ]
          },
          {
            "key": "remap_max_iter",
            "label": "remap_max_iter",
            "type": "number",
            "default": 25
          },
          {
            "key": "trace_mse",
            "label": "trace_mse",
            "type": "boolean",
            "default": null
          }
        ]
      },
      "methods": {
        "physics": {
          "title": "Optimization (Gradient-based)",
          "essential": [],
          "advanced": [
            {
              "key": "num_iter",
              "label": "Iterations",
              "description": "Optimization iterations",
              "type": "number",
              "default": 1001,
              "step": 100,
              "min": 100
            },
            {
              "key": "batch_size",
              "label": "Batch size",
              "description": "Voxels per iteration (higher = more stable, slower)",
              "type": "number",
              "default": 500000,
              "step": 10000,
              "min": 10000
            },
            {
              "key": "TV2_reg",
              "label": "TV\u00b2 regularization",
              "description": "TV\u00b2 smoothness (0 = off; higher = smoother)",
              "type": "number",
              "default": 30,
              "step": 1,
              "min": 0
            },
            {
              "key": "deform_downsample_factor_xy",
              "label": "Deformation downsample (XY)",
              "description": "Coarse XY grid factor (higher = fewer DOFs)",
              "type": "number",
              "default": 10,
              "step": 1,
              "min": 1
            },
            {
              "key": "deform_downsample_factor_z",
              "label": "Deformation downsample (Z)",
              "description": "Coarse Z grid factor for deformation",
              "type": "number",
              "default": 8,
              "step": 1,
              "min": 1
            },
            {
              "key": "lock_global_shift",
              "label": "Lock global shift",
              "description": "Lock global shift after initial estimate",
              "type": "boolean",
              "default": null
            },
            {
              "key": "Uz_penalty_weight",
              "label": "Uz penalty weight",
              "description": "Penalty on upward Uz in coarse field (0 = off; higher biases Uz down)",
              "type": "number",
              "default": 0.0,
              "step": 0.5,
              "min": 0
            },
            {
              "key": "progress_every",
              "label": "Progress interval",
              "description": "Log progress every N iterations",
              "type": "number",
              "default": 100,
              "step": 100,
              "min": 1
            }
          ]
        },
        "ml_pretrained": {
          "title": "ML (Pretrained) \u2014 placeholder",
          "essential": [],
          "advanced": []
        },
        "ml_train": {
          "title": "ML (Train) \u2014 placeholder",
          "essential": [],
          "advanced": []
        }
      }
    },
    "inverse": {
      "title": "Inverse Modeling",
      "script": "github/fim/fim/refactor/main_VFM.py",
      "common": {
        "essential": [
          {
            "key": "model",
            "label": "Material model",
            "description": "Stress\u2013strain constitutive model",
            "type": "select",
            "default": "linear",
            "options": [
              {
                "value": "linear",
                "label": "Linear (Transversely Isotropic)"
              },
              {
                "value": "hgo",
                "label": "HGO (Holzapfel-Gasser-Ogden)"
              },
              {
                "value": "nh",
                "label": "Neo-Hookean"
              }
            ]
          },
          {
            "key": "data_path",
            "label": "VFM data folder",
            "description": "Folder with Ux/Uy/Uz.npy from tracking",
            "type": "dir",
            "default": null
          },
          {
            "key": "force_n",
            "label": "Applied force",
            "description": "Applied indentation force",
            "type": "number",
            "default": 4.18e-05,
            "step": 1e-06,
            "unit": "N"
          }
        ],
        "advanced": []
      },
      "methods": {
        "linear": {
          "title": "Linear (Transversely Isotropic)",
          "essential": [
            {
              "key": "E1_init",
              "label": "E1 initial guess",
              "description": "Initial axial Young's modulus",
              "type": "number",
              "default": 15000,
              "unit": "Pa"
            },
            {
              "key": "E2_init",
              "label": "E2 initial guess",
              "description": "Initial transverse Young's modulus",
              "type": "number",
              "default": 15000,
              "unit": "Pa"
            },
            {
              "key": "v12",
              "label": "Poisson ratio v12",
              "description": "Poisson ratio \u03bd\u2081\u2082 (axial\u2013transverse)",
              "type": "number",
              "default": 0.49,
              "step": 0.01
            },
            {
              "key": "v23",
              "label": "Poisson ratio v23",
              "description": "Poisson ratio \u03bd\u2082\u2083 (transverse)",
              "type": "number",
              "default": 0.49,
              "step": 0.01
            },
            {
              "key": "Gt",
              "label": "Shear modulus Gt",
              "description": "In-plane transverse shear modulus",
              "type": "number",
              "default": 500,
              "unit": "Pa"
            },
            {
              "key": "mesh_file",
              "label": "Mesh file (.inp)",
              "description": "Optional .inp for geometry; else from grids",
              "type": "text",
              "default": null
            }
          ],
          "advanced": []
        },
        "hgo": {
          "title": "HGO (Holzapfel-Gasser-Ogden)",
          "essential": [
            {
              "key": "C10_init",
              "label": "C10 initial guess",
              "description": "Matrix stiffness (isotropic part)",
              "type": "number",
              "default": 500,
              "unit": "Pa"
            },
            {
              "key": "D1_init",
              "label": "D1 initial guess",
              "description": "Compressibility D\u2081 (lower \u2192 more incompressible)",
              "type": "number",
              "default": 1e-05,
              "step": 1e-06
            },
            {
              "key": "k1",
              "label": "Fiber stiffness k1",
              "description": "Collagen fiber stiffness k\u2081",
              "type": "number",
              "default": 2000,
              "unit": "Pa"
            },
            {
              "key": "k2",
              "label": "Fiber nonlinearity k2",
              "description": "Fiber exponential stiffening k\u2082",
              "type": "number",
              "default": 5
            },
            {
              "key": "kappa_init",
              "label": "Kappa initial guess",
              "description": "Fiber dispersion \u03ba (0 aligned; \u2153 isotropic)",
              "type": "number",
              "default": 0.05,
              "step": 0.01,
              "min": 0,
              "max": 0.33
            },
            {
              "key": "mesh_file",
              "label": "Mesh file (.inp)",
              "description": "Optional .inp for geometry; else from grids",
              "type": "text",
              "default": null
            }
          ],
          "advanced": []
        },
        "nh": {
          "title": "Neo-Hookean",
          "essential": [
            {
              "key": "C10_init",
              "label": "C10 initial guess",
              "description": "Shear modulus (Neo-Hookean)",
              "type": "number",
              "default": 500,
              "unit": "Pa"
            },
            {
              "key": "D1_init",
              "label": "D1 initial guess",
              "description": "Compressibility D\u2081 (lower \u2192 more incompressible)",
              "type": "number",
              "default": 1e-05,
              "step": 1e-06
            },
            {
              "key": "mesh_file",
              "label": "Mesh file (.inp)",
              "description": "Optional .inp for geometry; else from grids",
              "type": "text",
              "default": null
            }
          ],
          "advanced": []
        }
      }
    }
  }
}
